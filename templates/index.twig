{% extends "_layouts/site" %}

{% block content %}

  <div id="container">
  
    <div id="desktopIcons">

        {% set icons = craft.entries.section('programs').all() %}

        {% for icon in icons %}

            <div class="icon">
                <div 
                    class="pointer clickable" 
                    id="{{ icon.contentId }}"
                    data-window="{{ icon.windowType.value }}" 
                    data-can-duplicate="0"
                    data-window-icon="{{ icon.windowIcon.one().url }}"
                >
                <div class="iconImage">
                    <img id="tableBanner" src="{{ icon.icon.one().url }}">
                </div>
                <label class="pointer selectedLabel">{{ icon.title }}</label>
                </div>
            </div>

        {% endfor %}

    </div>

    <!-- <img id="plane_flight" src="assets/Sprites/Airplane_flight.gif"> -->
    <img id="me" src="assets/Sprites/Me_idle_left.gif">

    <div id="speechBubble">
      <div id="top"></div>
      <div id="middle"></div>
      <div id="bottom"></div>
    </div>

  </div>

  <div class="window" id="taskbar">
    <ul class="dropdown">
      <li>
        <a href="#" class="pointer"></a>
        
        <ul class="window" id="mainMenu">

          <div id="menuSideBar"><p>Windows98</p></div>


          <li class="silver">
            <a href="#" class="pointer">
              <img src="assets/W98Cursor/normal.cur" class="subImg">
              <span>Cursor</span>
              <arrow></arrow>
            </a>

            <ul class="window">
              <li><a class="cursorOptions pointer" id="Mario"><img class="subImg" src="assets/MarioCursor/normal.cur"><span>Mario</span></a></li>
              <li><a class="cursorOptions pointer" id="RA"><img class="subImg" src="assets/RACursor/normal.cur"><span>Runescape</span></a></li>
              <li><a class="cursorOptions pointer" id="MC"><img class="subImg" src="assets/MCCursor/normal.cur"><span>Minecraft</span></a></li>
              <li><a class="cursorOptions pointer" id="W98"><img class="subImg" src="assets/W98Cursor/normal.cur"><span>Windows98</span></a></li>
              <li><a class="cursorOptions pointer"><img src="assets/icons/remove.png" class="subImg"><span>Reset cursor</span></a></li>
            </ul>
          </li>

          <li class="silver pointer">
            <a href="#" class="pointer">
              <img src="assets/icons/background.png" class="subImg">
              <span>Background</span>
              <arrow></arrow>
            </a>
            
            <ul class="window">
              <li id="openImgUpload">
                <a class="pointer">
                  <img src="assets/icons/upload.png" class="subImg">
                  <span>Upload image</span>
                  <input type="file" id="file">
                </a>
              </li>
              <li id="removeBackground">
                <a class="pointer">
                  <img src="assets/icons/remove.png" class="subImg">
                  <span>Reset background</span>
                </a>
              </li>
            </ul>
          </li>
          
          <li class="silver pointer">
            <a href="#" class="pointer">
              <img src="assets/icons/keyboard-3.png" class="subImg">
              <span>Languages</span>
              <arrow></arrow>
            </a>
            <ul class="window">
              <li class="language" data-language="nl">
                <a class="pointer">
                  <img src="assets/icons/placeholder.png" class="subImg">
                  <span>Dutch</span>
                </a>
              </li>
              <li class="language" data-language="en">
                <a class="pointer">
                  <img src="assets/icons/placeholder.png" class="subImg">
                  <span>English</span>
                </a>
              </li>
            </ul>
          </li>
          
        </ul>
      </li>
    </ul>

    <pre class="v-line-in"></pre>

    <div id="tabs"></div> 
    
    <div id="clock"></div>
  </div>

{% endblock %}

{% block foot %}

    {{ parent() }}

        <script>
            {% set csrfToken = {
                csrfTokenName: craft.app.config.general.csrfTokenName,
                csrfTokenValue: craft.app.request.csrfToken,
            } %}

            window.Craft = {{ csrfToken|json_encode|raw }};
        </script>

{% endblock %}