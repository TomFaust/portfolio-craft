{% extends "_layouts/site" %}

{% block content %}

  <div id="container">
  
    <div id="desktopIcons">

        {% set icons = craft.entries.section('icons').display(1).all() %}

        {% for icon in icons %}

          {% if icon.iconImg.one()|length %}
            <div class="icon">
                <div 
                    class="pointer clickable" 
                    id="{{ icon.contentId }}"
                    data-entryid="{{ icon.id }}"
                    data-can-duplicate="{{ icon.canBeDuplicated }}"
                >
                <div class="iconImage">
                    <img id="tableBanner" src="{{ icon.iconImg.one().url }}">
                </div>
                <label class="pointer selectedLabel">{{ icon.title }}</label>
                </div>
            </div>
          {% endif %}

        {% endfor %}

    </div>

    <img id="me" src="public/img/sprites/Me_idle_left.gif">

    <div id="speechBubble">
      <div id="top"></div>
      <div id="middle"></div>
      <div id="bottom"></div>
    </div>

  </div>

  <input class="hidden" type="file" id="file">

  <div class="window" id="taskbar">
    <ul class="dropdown">

      <li>
         <a href="#" class="pointer"></a>
         <ul class="window" id="mainMenu">
          <div id="menuSideBar"><p>Windows98</p></div>

            {% set options = craft.entries.section('menu').level(1).all() %}

            {% for option in options %}
              {% if option.iconImg.one()|length %}
                <li class="silver" id="{{ option.contentId }}" data-entryid="{{ option.id }}">
                  <a href="{% if option.linkAddress|length %}{{ option.linkAddress }}{% else %}#{% endif %}" class="pointer">
                    <img src="{{ option.iconImg.one().url }}" class="subImg">
                    <span>{{ option.title }}</span>
                    {% set children = option.getChildren().all() %}
                    {% if children|length %}
                      <arrow></arrow>
                    {% endif %}
                  </a>
                  <ul class="window">
                    {% for child in children %}
                      {% if child.iconImg.one()|length %}
                        <li id="{{ child.contentId }}" data-entryid="{{ child.id }}">
                          <a class="pointer" href="{% if child.linkAddress|length %}{{ child.linkAddress }}{% else %}#{% endif %}">
                            <img src="{{ child.iconImg.one().url }}" class="subImg">
                            <span>{{ child.title }}</span>
                          </a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </li>
              {% endif %}
            {% endfor %}

         </ul> 
      </li>
    </ul>

    <pre class="v-line-in"></pre>

    <div id="tabs"></div> 
    
    <div id="clock"></div>
  </div>

{% endblock %}

{% block foot %}

    {{ parent() }}

        <script>
            {% set csrfToken = {
                csrfTokenName: craft.app.config.general.csrfTokenName,
                csrfTokenValue: craft.app.request.csrfToken,
            } %}

            window.Craft = {{ csrfToken|json_encode|raw }};

            {% set welcome = craft.entries.section('icons').slug('welcome').one() %}
            {% if welcome %}
              window.welcome = {{ welcome.id }};
            {% endif %}
        </script>

{% endblock %}