{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ snakeTitle }}
{% endblock %}

{% block content %}
    <div class="header">
        <img src="/public/img/logo.png">
        <div class="gradient"></div>
    </div>

    <div class="main">
        <div class="explore">
            <div class="exploreContent">
                {{ "CONTENTS"|t }}
            </div>
            {% for welcomeButton in block.welcomeButtons %}
                <div class="exploreButton pointer " id="welcome-{{ welcomeButton.id }}">
                    <div class="colorBox"></div>
                    {{ welcomeButton.text }}
                </div>
            {% endfor %}
        </div>
        <div>
            <h1>{{ entryTitle }}</h1>
        
            {{ block.body }}
        </div>
    </div>

    <div class="footer">
        <div>
            <input type="checkbox" id="showEachTime" checked>
            <label for="showEachTime" class="pointer">{{ "Show this screen each time my portfolio starts"|t }}.</label>
        </div>
        <button id="welcome_ok" class="okay pointer">Ok</button>
    </div>

{% endblock %}
