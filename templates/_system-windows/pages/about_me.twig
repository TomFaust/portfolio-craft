{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ snakeTitle }}
{% endblock %}

{% block content %}
    <hr>
    <div class="content">
        <div class="sidebar">

            {% set topics = craft.categories.group("aboutMeTopics").all() %}

            <div>
                <menu role="tablist" class="multirows">
                    {% for topic in topics %}
                        <li role="tab"><a href="#tabs">{{ topic.title }}</a></li>
                    {% endfor %}
                </menu>
            </div>
            
            <div class="window" role="tabpanel">

                 {% for topic in topics %}
                    {% set entries = craft.entries.section("aboutMe").relatedTo(topic).all() %}
                    <ul class="tree-view">
                        {% for entry in entries %}
                            <li>
                                <a href="#" class="contantGroup pointer" data-panel="{{ entry.slug }}">
                                    <img src="{% if entry.iconImg.one() %} {{ entry.iconImg.one().url }} {% endif %}">
                                    {{ entry.title}}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                 {% endfor %} 
            </div>
        </div>

        <div class="devider">
            
        </div>

        <div class="main sunken-panel">

            {% for topic in topics %}
                {% set entries = craft.entries.section("aboutMe").relatedTo(topic).all() %}
                {% for entry in entries %}
                    <div class="about-me-panel" data-subject="{{ entry.slug }}" {% if entry.backgroundImage.one() %} style="background-image:url({{ entry.backgroundImage.one().url }})" {% endif %}>
                        {{ entry.body }}
                    </div>
                {% endfor %}
            {% endfor %}

        </div>
    </div>

{% endblock %}