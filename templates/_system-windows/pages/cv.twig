{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ snakeTitle }}
{% endblock %}

{% block content %}

  <object data="{% if block.pdfFile.one() %} {{ block.pdfFile.one().url }} {% endif %}" type="application/pdf" >

    <div id="altCV" class="sunken-panel">
      <span>
        {{ block.body }}
      </span>
    </div>

  </object>

{% endblock %}