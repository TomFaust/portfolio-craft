{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ snakeTitle }}
{% endblock %}

{% block content %}

  {% set entry = craft.entries.slug('cv').section('cv').one() %}

  <object data="{% if entry.pdfFile.one() %} {{ entry.pdfFile.one().url }} {% endif %}" type="application/pdf" >

    <div id="altCV" class="sunken-panel">
      <span>

        {{ entry.body }}

      </span>
    </div>

  </object>

{% endblock %}