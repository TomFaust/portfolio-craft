{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ snakeTitle }}
{% endblock %}

{% block content %}

    {% set workFolders = craft.entries()
        .section('pastWork')
        .hasDescendants(true)
        .all() %}

    {% for workFolder in workFolders %}
        <div class="folderPanel {% if not loop.first %} d-none {% endif %}" data-subject="{% if loop.first %}main{%else%}{{ workFolder.id }}{%endif%}">
            {% set children = workFolder.getChildren().all() %}
            {% for child in children %}
                {% if child.iconImg.one() %}
                    <div class="folderIcon pointer {% if child.hasDescendants %} clickableIcon {% else %} openingIcon {% endif %}" data-panel="{{ child.id }}"  data-title="{{ workFolder.title }}" data-url="{{ child.linkAddress }}">
                        <img src="{{ child.iconImg.one().url }}">
                        <label class="pointer">{{ child.title }}</label>
                    </div>
                {% endif %}
            {% endfor %}
        </div>    
    {% endfor %}

{% endblock %}