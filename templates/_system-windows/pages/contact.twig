{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ title }}
{% endblock %}

{% macro renderStructure(entries) %}
    <ul>
        {% for entry in entries %}
            <li class="contantGroup pointer">
              {% if entry.iconImg.one() %}
                <img src="{{ entry.iconImg.one().url }}">
              {% endif %}

              {{ entry.title }}

              {% if entry.children|length %}
                  {{ _self.renderStructure(entry.children) }}
              {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block content %}
  <div id="contantGroups">
      <ul class="tree-view">
          <li>
            {% set entries = craft.entries()
            .section('contact')
            .level(1)
            .all() %}

            {% for entry in entries %}
              <details open>
                <summary>
                    {% if entry.iconImg.one() %}
                      <img src="{{ entry.iconImg.one().url }}">
                    {% endif %}
                    {{ entry.title }}
                </summary>
                {{ _self.renderStructure(entry.getChildren().all()) }}
            {% endfor %}

          </li>
        </ul>
  </div>


  <div class="contactList">
      <div class="searchInput">
          <div class="field-row">
              <label for="searchContacts">Type name or select from list:</label>
              <input id="searchContacts" type="text" />
            </div>
      </div>

      {% set entries = craft.entries()
            .section('contact')
            .hasDescendants(false)
            .all() %}

      {% for entry in entries %}
        <div id="social" class="sunken-panel contacts">
          <table class="interactive">
            <thead>
              <tr>
                <th>Name</th>
                <th>Link</th>
                <th>Quick response?</th>
              </tr>
            </thead>
            <tbody class="list">
              {% set rows = entry.contactInformation %}
              {% for row in rows %}
                <tr >
                  <td class="name">{{ row.name }}</td>
                  <td class="link">
                    <span onclick="window.open('{% if row.type == 'email' %}mailto:{% endif %}{{ row.link }}')">{{ row.link }}</span>
                  </td>
                  <td class="quick">{{ row.quickResponse }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endfor %}
  </div>
{% endblock %}