{% extends "_system-windows/layouts/" ~ layout %}

{% block head %}
    <img class="title-bar-icon" src="{{ titleIcon }}"> {{ title }}
{% endblock %}

{% block content %}

    {% set socialMedia = craft.entries.section('socialMedia').all() %}

    <pre>
        <div class="pre_inset pointer">
            {% for media in socialMedia %}
                {% if media.image.one() %}
                    <div class="browser_screen {% if not loop.first %}d-none{% endif %}" data-subject="{{ media.slug }}" data-url="{{ media.linkAddress }}">
                        <img 
                        src="{{ media.image.one().url }}">
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </pre>

{% endblock %}